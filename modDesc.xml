<?xml version="1.0" encoding="UTF-8"?>
<modDesc descVersion="110">
    <title>FFA Media Player</title>
    <description>
        In-game media browser for Farming Simulator 25.
        Open Spotify Web or CriderGPT directly inside the game.
        Press F9 to toggle the window. Fully draggable, minimizable, and FFA-themed.
    </description>
    <author>Jessie Crider</author>
    <version>1.1.0</version>
    <iconFilename>icon.png</iconFilename>
    <bannerFilename>banner.png</bannerFilename>

    <fs19_compatible>false</fs19_compatible>
    <fs22_compatible>false</fs22_compatible>
    <fs23_compatible>false</fs23_compatible>
    <fs25_compatible>true</fs25_compatible>

    <multiplayerCompatible>true</multiplayerCompatible>

    <scripts>
        <script filename="CustomMediaPlayer.lua"/>
    </scripts>

    <l10n>
        <text name="FFA_MEDIA_PLAYER_TITLE" text="FFA Media Player"/>
    </l10n>
</modDesc>
